# Chat model: any Ollama tag (or vLLM model name). Pick one that fits your hardware,
# using the exact tag from ollama.com/library, e.g. a Qwen3.8-27B or Gemma 4 31B build.
LLM_MODEL=CHANGE_ME
LLM_BASE_URL=http://ollama:11434/v1

# Embeddings (small, runs fine on CPU)
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://ollama:11434/v1

QDRANT_URL=http://qdrant:6333
TOP_K=6

# Keep Hugging Face libraries from reaching the internet at runtime.
# Parser models are baked into the image at build time.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=false
